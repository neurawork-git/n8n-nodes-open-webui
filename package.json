{
  "name": "n8n-nodes-open-webui",
  "version": "0.1.0",
  "description": "n8n-Baustein für Open WebUI: Chat mit Modellen und Presets, Wissensdatenbanken, Dateien und Audio — per Auswahlliste statt Hand-JSON.",
  "license": "MIT",
  "homepage": "https://github.com/NeuraMax/n8n-nodes-open-webui",
  "author": {
    "name": "Neurawork",
    "email": "maximilian.koenig@neurawork.ai"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NeuraMax/n8n-nodes-open-webui.git"
  },
  "bugs": {
    "url": "https://github.com/NeuraMax/n8n-nodes-open-webui/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "open-webui",
    "openwebui",
    "rag",
    "knowledge-base"
  ],
  "scripts": {
    "build": "n8n-node build",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "format": "prettier nodes credentials test --write",
    "test": "jest",
    "test:e2e": "jest --config jest.e2e.config.js",
    "gen:sidecar": "node scripts/gen-sidecar.mjs",
    "prepublishOnly": "npm run lint && npm run build"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/OpenWebUiApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/OpenWebUi/OpenWebUi.node.js",
      "dist/nodes/OpenWebUi/OpenWebUiRead.node.js",
      "dist/nodes/OpenWebUi/OpenWebUiWrite.node.js"
    ]
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "devDependencies": {
    "@n8n/node-cli": "0.53.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.5",
    "eslint": "9.39.4",
    "jest": "^29.7.0",
    "n8n-workflow": "2.44.1",
    "prettier": "3.8.3",
    "ts-jest": "^29.4.15",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@langchain/community": {
      "ignore": "5.3.2"
    }
  }
}
